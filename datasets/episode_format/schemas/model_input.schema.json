{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cape-rgb-episode-v0.1-draft / model_input",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "support": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "u": {
                "type": "number"
              },
              "v": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "u",
              "v"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "image",
        "size",
        "points"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "image",
        "size"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sample_id",
    "support",
    "query"
  ],
  "additionalProperties": false
}
