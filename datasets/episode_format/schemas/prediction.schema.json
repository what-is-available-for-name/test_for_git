{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cape-rgb-episode-v0.1-draft / prediction",
  "type": "object",
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "coordinate_version": {
      "enum": [
        "pascal_source_pretheta_v1",
        "image_camera_cv_candidate_v1"
      ]
    },
    "unit": {
      "enum": [
        "scale_free",
        "cad_normalised"
      ]
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "xyz": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "id",
          "xyz"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "sample_id",
    "coordinate_version",
    "points"
  ],
  "additionalProperties": false
}
